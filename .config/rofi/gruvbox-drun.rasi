/* Gruvbox dark application launcher. */
* {
    bg: #000000;
    fg: #ebdbb2;
    muted: #a89984;
    surface: #3c3836;
    accent: #8ec07c;
    red: #fb4934;
    green: #8ec07c;

    font: "Input Mono 12";
    background-color: transparent;
    text-color: @fg;
    border-color: @surface;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 0;
    padding: 18px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 14px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 14px;
    padding: 4px 6px 16px;
    border: 0 0 1px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search applications…";
    placeholder-color: @muted;
    cursor-color: @accent;
}

listview {
    lines: 5;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    children: [ element-icon, element-text ];
    padding: 10px;
    spacing: 12px;
    border-radius: 0;
    cursor: pointer;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active, element alternate.active {
    text-color: @green;
}

element normal.urgent, element alternate.urgent {
    text-color: @red;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @accent;
    text-color: @bg;
}

element-icon, element-text {
    text-color: inherit;
    cursor: inherit;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
    highlight: bold underline;
}

message {
    padding: 8px;
    background-color: @surface;
    border-radius: 0;
}

error-message {
    children: [ textbox ];
    padding: 12px;
}
